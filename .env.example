NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The seller's WhatsApp for the footer link: 92 then the mobile number, e.g. 923001234567.
WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Session pooler connection string. Used only by `pnpm check:rls`, never by the app.
DATABASE_URL=
# Where the seller's phone gets pings. Uncomment only for a server other than ntfy.sh.
# NTFY_URL=https://ntfy.sh
# A long random secret, e.g. from `openssl rand -hex 16`; subscribe to it in the ntfy app.
NTFY_TOPIC=
# This site's own address, for the link in a ping, e.g. http://localhost:3000.
SITE_URL=
