NEXT_PUBLIC_CLERK_SIGN_IN_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# The seller's WhatsApp for the footer link: 92 then the mobile number, e.g. 923001234567.
WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Session pooler connection string. Used only by `pnpm check:rls`, never by the app.
DATABASE_URL=
# This site's own address, for the link in the seller's notifications, e.g. http://localhost:3000.
SITE_URL=
# Encrypts every credential in customers' vaults: 32 random bytes from `openssl rand -base64 32`.
# Keep a copy in a password manager. Lose it and every vault entry is unreadable.
VAULT_KEY=
# Web Push for the seller's browsers: both from `pnpm exec web-push generate-vapid-keys`.
# Changing them switches off every registered browser; switch them on again after.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Resend, free plan. Sign up to Resend with SELLER_EMAIL: without a verified domain it only sends there.
RESEND_API_KEY=
SELLER_EMAIL=
