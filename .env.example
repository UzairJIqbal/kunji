# Copy to .env.local and fill in. The app refuses to start if any value is missing or malformed.

# Clerk's sign-in page, inside this app: /sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_URL=
# Clerk's sign-up page, inside this app: /sign-up
NEXT_PUBLIC_CLERK_SIGN_UP_URL=
# Where a customer lands after signing in when there's no page to return to: /
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=
# Where a customer lands after signing up when there's no page to return to: /
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=
# Clerk dashboard → API keys, starts pk_.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk dashboard → API keys, starts sk_. Server only.
CLERK_SECRET_KEY=
# The seller's WhatsApp for the footer link: 92 then the mobile number, e.g. 923001234567.
WHATSAPP_NUMBER=
# Supabase dashboard → Project settings → API, e.g. https://xxxx.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable key, starts sb_publishable_. Never the service key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Session pooler connection string. Used only by `pnpm check:rls`, never by the app.
DATABASE_URL=
# This site's own address, for links in the seller's notifications and the link preview card, e.g. http://localhost:3000.
SITE_URL=
# Encrypts every credential in customers' vaults: 32 random bytes from `openssl rand -base64 32`.
# Keep a copy in a password manager. Lose it and every vault entry is unreadable.
VAULT_KEY=
# Web Push public key for the seller's browsers, from `pnpm exec web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
# Its private half. Changing the pair switches off every registered browser; switch them on again after.
VAPID_PRIVATE_KEY=
# Resend API key (free plan), starts re_. Sign up to Resend with SELLER_EMAIL.
RESEND_API_KEY=
# Where new-order emails go. Without a verified domain, Resend only delivers to its own account's address.
SELLER_EMAIL=
